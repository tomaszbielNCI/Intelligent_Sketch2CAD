# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data files (keep structure, ignore content)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/labels/*
!data/labels/.gitkeep

# Output files
output/*
!output/.gitkeep

# Models
models/checkpoints/*
!models/checkpoints/.gitkeep

# Logs
*.log

# FreeCAD files
*.fcstd
*.dxf

# Temporary files
*.tmp
*.temp

# Large model and data files
*.pt
*.pth
*.h5
*.hdf5
*.pkl
*.pickle
*.tar

# Configuration files (except specific ones)
*.yaml
*.yml
!sam2_hiera_s.yaml

# SAM2 models (very large)
sam2_hiera_small.pt
sam2_hiera_base.pt
sam2_hiera_large.pt

# Image files (large ones) - but allow small config images
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.tif
!*.png.small
!*.jpg.small

# Document files
*.pdf
*.docx
*.doc

# DeepLSD submodule and models
DeepLSD/weights/*
!DeepLSD/weights/.gitkeep

# Intermediate and output data
intermediate_data/*
output_data/*
!intermediate_data/.gitkeep
!output_data/.gitkeep
