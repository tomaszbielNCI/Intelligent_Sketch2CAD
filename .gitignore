# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data files (keep structure, ignore content)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/labels/*
!data/labels/.gitkeep

# Output files
output/*
!output/.gitkeep

# Models
models/checkpoints/*
!models/checkpoints/.gitkeep

# Logs
*.log

# FreeCAD files
*.fcstd
*.dxf

# Temporary files
*.tmp
*.temp

# Large model and data files
*.pt
*.pth
*.h5
*.hdf5
*.pkl
*.pickle

# Configuration files
*.yaml
*.yml

# Image files (large ones)
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.tif

# Document files
*.pdf
*.docx
*.doc

# Intermediate and output data
intermediate_data/*
output_data/*
!intermediate_data/.gitkeep
!output_data/.gitkeep
